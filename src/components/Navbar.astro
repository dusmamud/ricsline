---
import { Icon } from 'astro-icon/components';
import Logo from './Logo.astro';
import ThemeToggle from './ThemeToggle.astro';
import LanguageSwitcher from './LanguageSwitcher.astro';
import { link, type Locale } from '../i18n/index';
import type { Dict } from '../i18n/dicts';

interface Props {
  locale: Locale;
  path: string;
  dict: Dict;
}
const { locale, path, dict } = Astro.props;
const links = [
  { href: link(locale, '/maker'), label: dict.nav.maker, icon: 'ph:waveform' },
  { href: link(locale, '/about'), label: dict.nav.about, icon: 'ph:info' },
];
---
<header class="sticky top-0 z-40 border-b border-graphite-200/70 bg-white/80 backdrop-blur-xl dark:border-graphite-800 dark:bg-graphite-950/80">
  <nav class="mx-auto flex h-16 max-w-7xl items-center justify-between gap-3 px-4 sm:px-6" aria-label="Main">
    <a href={link(locale, '/')} class="flex items-center gap-2.5">
      <Logo size={34} />
      <span class="font-display text-xl font-extrabold tracking-tight text-graphite-900 dark:text-white">
        Ricsline
      </span>
    </a>

    <div class="hidden items-center gap-1 md:flex">
      {links.map((l) => (
        <a
          href={l.href}
          class="rounded-lg px-3.5 py-2 text-sm font-medium text-graphite-600 transition hover:bg-graphite-100 hover:text-graphite-900 dark:text-graphite-300 dark:hover:bg-graphite-800 dark:hover:text-white"
        >
          {l.label}
        </a>
      ))}
    </div>

    <div class="flex items-center gap-2">
      <LanguageSwitcher locale={locale} path={path} dict={dict} />
      <ThemeToggle dict={dict} />
      <a
        href={link(locale, '/maker')}
        class="hidden items-center gap-1.5 rounded-xl bg-brand-500 px-4 py-2.5 text-sm font-semibold text-white transition hover:bg-brand-600 sm:inline-flex"
      >
        <Icon name="ph:lightning" class="h-4 w-4" />
        {dict.nav.startFree}
      </a>
      <button
        type="button"
        data-nav-toggle
        class="inline-flex h-10 w-10 items-center justify-center rounded-xl border border-graphite-200 text-graphite-600 md:hidden dark:border-graphite-700 dark:text-graphite-300"
        aria-label="Menu"
      >
        <Icon name="ph:list" class="h-5 w-5" data-nav-icon-open />
        <Icon name="ph:x" class="hidden h-5 w-5" data-nav-icon-close />
      </button>
    </div>
  </nav>

  <div data-nav-mobile class="hidden border-t border-graphite-200 px-4 py-3 md:hidden dark:border-graphite-800">
    {links.map((l) => (
      <a
        href={l.href}
        class="flex items-center gap-3 rounded-lg px-3 py-2.5 text-sm font-medium text-graphite-700 dark:text-graphite-200"
      >
        <Icon name={l.icon} class="h-5 w-5 text-brand-500" />
        {l.label}
      </a>
    ))}
    <a
      href={link(locale, '/maker')}
      class="mt-2 flex items-center justify-center gap-1.5 rounded-xl bg-brand-500 px-4 py-2.5 text-sm font-semibold text-white transition hover:bg-brand-600"
    >
      <Icon name="ph:lightning" class="h-4 w-4" />
      {dict.nav.startFree}
    </a>
  </div>
</header>

<script>
  function initNav() {
    const toggle = document.querySelector('[data-nav-toggle]');
    const mobile = document.querySelector('[data-nav-mobile]');
    const open = document.querySelector('[data-nav-icon-open]');
    const close = document.querySelector('[data-nav-icon-close]');
    toggle?.addEventListener('click', () => {
      const hidden = mobile?.classList.toggle('hidden');
      open?.classList.toggle('hidden', !hidden);
      close?.classList.toggle('hidden', !!hidden);
    });
  }
  document.addEventListener('astro:page-load', initNav);
  initNav();
</script>
