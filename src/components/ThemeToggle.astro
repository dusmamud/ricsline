---
import { Icon } from 'astro-icon/components';
import type { Dict } from '../i18n/dicts';

interface Props {
  dict: Dict;
}
const { dict } = Astro.props;
---
<div class="relative" data-theme-root>
  <button
    type="button"
    data-theme-btn
    aria-label={dict.nav.theme}
    title={dict.nav.theme}
    class="inline-flex h-10 w-10 items-center justify-center rounded-xl border border-graphite-200 text-graphite-600 transition hover:border-brand-400 hover:text-brand-600 dark:border-graphite-700 dark:text-graphite-300 dark:hover:border-brand-400 dark:hover:text-brand-300"
  >
    <span data-theme-icon-light class="hidden"><Icon name="ph:sun" class="h-5 w-5" /></span>
    <span data-theme-icon-dark class="hidden"><Icon name="ph:moon" class="h-5 w-5" /></span>
    <span data-theme-icon-system><Icon name="ph:monitor" class="h-5 w-5" /></span>
  </button>
  <div
    data-theme-list
    class="absolute end-0 z-50 mt-2 hidden w-40 overflow-hidden rounded-xl border border-graphite-200 bg-white shadow-xl dark:border-graphite-700 dark:bg-graphite-900"
  >
    <button type="button" data-theme-set="light" class="flex w-full items-center gap-2.5 px-4 py-2.5 text-sm text-graphite-700 hover:bg-graphite-100 dark:text-graphite-200 dark:hover:bg-graphite-800">
      <Icon name="ph:sun" class="h-4 w-4" /> {dict.nav.themeLight}
    </button>
    <button type="button" data-theme-set="dark" class="flex w-full items-center gap-2.5 px-4 py-2.5 text-sm text-graphite-700 hover:bg-graphite-100 dark:text-graphite-200 dark:hover:bg-graphite-800">
      <Icon name="ph:moon" class="h-4 w-4" /> {dict.nav.themeDark}
    </button>
    <button type="button" data-theme-set="system" class="flex w-full items-center gap-2.5 px-4 py-2.5 text-sm text-graphite-700 hover:bg-graphite-100 dark:text-graphite-200 dark:hover:bg-graphite-800">
      <Icon name="ph:monitor" class="h-4 w-4" /> {dict.nav.themeSystem}
    </button>
  </div>
</div>

<script>
  function currentTheme(): string {
    try {
      return localStorage.getItem('ricsline-theme') || 'system';
    } catch {
      return 'system';
    }
  }
  function applyTheme(t: string) {
    const dark =
      t === 'dark' || (t === 'system' && window.matchMedia('(prefers-color-scheme: dark)').matches);
    document.documentElement.classList.toggle('dark', dark);
    document.querySelectorAll('[data-theme-root]').forEach((root) => {
      (root.querySelector('[data-theme-icon-light]') as HTMLElement).classList.toggle('hidden', t !== 'light');
      (root.querySelector('[data-theme-icon-dark]') as HTMLElement).classList.toggle('hidden', t !== 'dark');
      (root.querySelector('[data-theme-icon-system]') as HTMLElement).classList.toggle('hidden', t !== 'system');
    });
  }
  function initTheme() {
    applyTheme(currentTheme());
    document.querySelectorAll('[data-theme-root]').forEach((root) => {
      const btn = root.querySelector('[data-theme-btn]');
      const list = root.querySelector('[data-theme-list]');
      btn?.addEventListener('click', (e) => {
        e.stopPropagation();
        list?.classList.toggle('hidden');
      });
      root.querySelectorAll('[data-theme-set]').forEach((opt) => {
        opt.addEventListener('click', () => {
          const t = (opt as HTMLElement).dataset.themeSet || 'system';
          try {
            localStorage.setItem('ricsline-theme', t);
          } catch {}
          applyTheme(t);
          list?.classList.add('hidden');
        });
      });
    });
    document.addEventListener('click', () => {
      document.querySelectorAll('[data-theme-list]').forEach((l) => l.classList.add('hidden'));
    });
    window.matchMedia('(prefers-color-scheme: dark)').addEventListener('change', () => {
      if (currentTheme() === 'system') applyTheme('system');
    });
  }
  document.addEventListener('astro:page-load', initTheme);
  initTheme();
</script>
