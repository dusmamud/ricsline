---
import { Icon } from 'astro-icon/components';
import BaseLayout from '../layouts/BaseLayout.astro';
import { getDict } from '../i18n/dicts';

const locale = 'en';
const dict = getDict(locale);
---
<BaseLayout locale={locale} dict={dict} title={`404 — Ricsline`} description={dict.meta.landingDescription} path="/">
  <section class="mx-auto max-w-2xl px-4 py-24 text-center sm:px-6">
    <img
      src="/images/404-art.jpg"
      alt=""
      loading="lazy"
      class="mx-auto w-64 rounded-3xl border border-graphite-200 object-cover shadow-xl sm:w-80 dark:border-graphite-800"
    />
    <h1 class="mt-8 font-display text-4xl font-extrabold tracking-tight text-graphite-900 sm:text-5xl dark:text-white">
      {dict.notFound.title}
    </h1>
    <p class="mx-auto mt-4 max-w-md text-graphite-500 dark:text-graphite-400">{dict.notFound.text}</p>
    <a
      href="/en/"
      class="mt-8 inline-flex items-center gap-2 rounded-2xl bg-gradient-to-r from-brand-500 to-cyan-500 px-7 py-3.5 font-semibold text-white shadow-xl shadow-brand-500/30 transition hover:brightness-110"
    >
      <Icon name="ph:house" class="h-5 w-5" />
      {dict.notFound.button}
    </a>
  </section>
</BaseLayout>
