---
import BaseLayout from '../../layouts/BaseLayout.astro';
import MakerApp from '../../islands/MakerApp';
import { locales, type Locale } from '../../i18n/index';
import { getDict } from '../../i18n/dicts';

export async function getStaticPaths() {
  return locales.map((locale) => ({ params: { locale } }));
}

const { locale } = Astro.params as { locale: Locale };
const dict = getDict(locale);
---
<BaseLayout
  locale={locale}
  dict={dict}
  title={dict.meta.makerTitle}
  description={dict.meta.makerDescription}
  path="/maker"
>
  <section class="mx-auto max-w-7xl px-4 py-10 sm:px-6 lg:py-14">
    <MakerApp dict={dict} locale={locale} client:only="react" />
  </section>
</BaseLayout>
