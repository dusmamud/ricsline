---
import { Icon } from 'astro-icon/components';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { asset, locales, type Locale } from '../../i18n/index';
import { getDict } from '../../i18n/dicts';

export async function getStaticPaths() {
  return locales.map((locale) => ({ params: { locale } }));
}

const { locale } = Astro.params as { locale: Locale };
const dict = getDict(locale);
---
<BaseLayout locale={locale} dict={dict} title={dict.meta.aboutTitle} description={dict.meta.aboutDescription} path="/about">
  <section class="mx-auto max-w-3xl px-4 py-16 sm:px-6 lg:py-24">
    <p class="reveal inline-flex items-center gap-2 rounded-full border border-brand-200 bg-brand-50 px-4 py-1.5 text-xs font-semibold text-brand-700 dark:border-brand-500/30 dark:bg-brand-500/10 dark:text-brand-300">
      <Icon name="ph:info" class="h-3.5 w-3.5" />
      Ricsline
    </p>
    <h1 class="reveal reveal-d1 mt-6 font-display text-4xl font-extrabold tracking-tight text-graphite-900 sm:text-5xl dark:text-white">
      {dict.about.title}
    </h1>
    <p class="reveal reveal-d2 mt-6 text-lg leading-relaxed text-graphite-500 dark:text-graphite-400">
      {dict.about.intro}
    </p>

    <figure class="reveal mt-10 overflow-hidden rounded-3xl border border-graphite-200 shadow-xl dark:border-graphite-800">
      <img src={asset('/images/about-studio.jpg')} alt="Ricsline studio illustration" loading="lazy" class="w-full object-cover" />
    </figure>

    <div class="mt-12 space-y-8">
      {dict.about.sections.map((s, i) => (
        <article class={`reveal rounded-3xl border border-graphite-200 bg-white p-8 dark:border-graphite-800 dark:bg-graphite-900 ${i % 2 ? 'reveal-d1' : ''}`}>
          <h2 class="font-display text-xl font-bold text-graphite-900 dark:text-white">{s.title}</h2>
          <p class="mt-3 leading-relaxed text-graphite-500 dark:text-graphite-400">{s.text}</p>
        </article>
      ))}
    </div>
  </section>
</BaseLayout>
